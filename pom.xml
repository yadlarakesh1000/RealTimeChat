<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.rakesh.chat</groupId>
  <artifactId>realtime-chat</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Java Real-Time Chat Application</name>

  <properties>
    <!-- release (not source/target) so the compiler also checks the API against JDK 17 -->
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
    <!-- The 17.x line of JavaFX is the one that matches a Java 17 JDK. -->
    <javafx.version>17.0.20</javafx.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Phase 7. JavaFX left the JDK in Java 11, so it is an ordinary dependency now.
         javafx-controls pulls in javafx-base and javafx-graphics with it, and Maven picks
         the right windows/mac/linux build automatically. -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>

      <!-- Pinned so the checkpoint command in PROTOCOL.md resolves the same plugin
           version every time, rather than whatever the prefix lookup finds today. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <mainClass>com.rakesh.chat.server.ChatServer</mainClass>
        </configuration>
      </plugin>

      <!-- Phase 7. `mvn javafx:run` starts the GUI client. The plugin's job is to put the
           JavaFX jars on the *module* path, which is what stops the classic
           "JavaFX runtime components are missing" error. -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>com.rakesh.chat.client.Main</mainClass>
        </configuration>
      </plugin>

      <!-- Phase 10. `mvn package` now also builds two runnable jars.

           A plain jar only holds MY classes, so `java -jar` on it dies with
           NoClassDefFoundError the moment it needs JavaFX. Shade builds a "fat jar":
           my classes plus every dependency's classes, unpacked into one file, with a
           Main-Class written into the manifest so `java -jar` knows where to start.

           Two executions because this project has two programs. shadedArtifactAttached
           keeps the ordinary realtime-chat-0.1.0-SNAPSHOT.jar as the main build output
           and adds each fat jar beside it. outputFile then gives them short, fixed
           names, so run-server.sh does not have to be edited every time the version
           number changes:

             target/chat-server.jar
             target/chat-client.jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.2</version>

        <configuration>
          <createDependencyReducedPom>false</createDependencyReducedPom>
          <filters>
            <filter>
              <artifact>*:*</artifact>
              <excludes>
                <!-- Signed jars carry a signature over their own file list. Merging them
                     into a new jar breaks that signature, and Java then refuses to load
                     the classes ("Invalid signature file digest"). Dropping the signature
                     files is the standard fix. -->
                <exclude>META-INF/*.SF</exclude>
                <exclude>META-INF/*.DSA</exclude>
                <exclude>META-INF/*.RSA</exclude>
                <exclude>module-info.class</exclude>
              </excludes>
            </filter>
          </filters>
        </configuration>

        <executions>
          <execution>
            <id>server-jar</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>server</shadedClassifierName>
              <outputFile>${project.build.directory}/chat-server.jar</outputFile>
              <artifactSet>
                <excludes>
                  <!-- The server never draws a window, so shipping ~20 MB of JavaFX with
                       it would be dead weight on every copy. -->
                  <exclude>org.openjfx:*</exclude>
                </excludes>
              </artifactSet>
              <transformers>
                <transformer
                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.rakesh.chat.server.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>

          <execution>
            <id>client-jar</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>client</shadedClassifierName>
              <outputFile>${project.build.directory}/chat-client.jar</outputFile>
              <transformers>
                <transformer
                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <!-- client.Main, NOT ChatWindow. A main class that extends Application
                       makes the JavaFX launcher demand the module path; this one does not
                       extend it, so the fat jar runs from the plain classpath. See the
                       javadoc on client/Main.java. -->
                  <mainClass>com.rakesh.chat.client.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
