<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.rakesh.chat</groupId>
  <artifactId>realtime-chat</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Java Real-Time Chat Application</name>

  <properties>
    <!-- release (not source/target) so the compiler also checks the API against JDK 17 -->
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
    <!-- The 17.x line of JavaFX is the one that matches a Java 17 JDK. -->
    <javafx.version>17.0.20</javafx.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Phase 7. JavaFX left the JDK in Java 11, so it is an ordinary dependency now.
         javafx-controls pulls in javafx-base and javafx-graphics with it, and Maven picks
         the right windows/mac/linux build automatically. -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>

      <!-- Pinned so the checkpoint command in PROTOCOL.md resolves the same plugin
           version every time, rather than whatever the prefix lookup finds today. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <mainClass>com.rakesh.chat.server.ChatServer</mainClass>
        </configuration>
      </plugin>

      <!-- Phase 7. `mvn javafx:run` starts the GUI client. The plugin's job is to put the
           JavaFX jars on the *module* path, which is what stops the classic
           "JavaFX runtime components are missing" error. -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>com.rakesh.chat.client.Main</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
